{
    "Version": "2008-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": ["arn:aws:s3:::<FMI_1>/*", "arn:aws:s3:::<FMI_2>"],
            "Condition": {
                "IpAddress": {
                    "aws:SourceIp": ["<FMI_3>/32"]
                }
            }
        }
    ]
}
